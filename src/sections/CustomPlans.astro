---
const highlights = [
  { title: 'Flexible Scheduling', desc: 'Daily, weekly, or one-time service', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0FA3A8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>` },
  { title: 'Custom Scope', desc: 'Tailored to your exact needs', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0FA3A8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.09a2 2 0 0 1-1-1.74v-.51a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.39a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path><circle cx="12" cy="12" r="3"></circle></svg>` },
  { title: 'Competitive Pricing', desc: 'Transparent, fair quotes', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0FA3A8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>` },
];
---

<section class="section-padding bg-[#F7F9FC]">
  <div class="content-max-width">
    <div class="text-center max-w-[800px] mx-auto">
      <h2 class="text-3xl lg:text-[40px] font-semibold leading-tight text-[#0B1F3F]">Need a Custom Cleaning Plan?</h2>
      <p class="text-[#6B7280] text-lg mt-4 leading-relaxed">Every facility is different. We work with you to design a cleaning program that fits your space, schedule, and budget. Whether you need daily service or a one-time deep clean, we have you covered.</p>
      <div class="flex flex-wrap justify-center gap-6 lg:gap-10 mt-10 animate-stagger">
        {highlights.map((h) => (
          <div class="flex flex-col items-center text-center max-w-[180px]">
            <div class="w-14 h-14 rounded-full bg-white flex items-center justify-center mb-3 shadow-sm">
              <div set:html={h.icon}></div>
            </div>
            <h3 class="font-semibold text-[#0B1F3F]">{h.title}</h3>
            <p class="text-sm text-[#6B7280] mt-1">{h.desc}</p>
          </div>
        ))}
      </div>
      <div class="mt-10">
        <a href="#contact" class="btn-primary">Contact Us for a Custom Quote</a>
      </div>
    </div>
  </div>
</section>
