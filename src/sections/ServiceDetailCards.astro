---
const serviceDetails = [
  {
    overline: 'FLAGSHIP SERVICE',
    title: 'Office Cleaning Services',
    body: "A clean office is a productive office. Our comprehensive office cleaning services ensure your workspace is always presentable, hygienic, and welcoming for employees and clients alike.",
    features: [
      'Daily & weekly schedules',
      'Surface sanitizing & dusting',
      'Restroom cleaning & restocking',
      'Kitchen & break room cleaning',
      'Trash removal & recycling',
      'Floor vacuuming & mopping',
    ],
    cta: 'Request Office Cleaning Quote',
    image: '/img/IMG_4223.jpg',
    imageAlt: 'Next Level Commercial Cleaning professional using backpack vacuum in a modern DC office',
  },
  {
    title: 'Janitorial Services',
    body: "Our janitorial programs keep your facility maintained day in and day out. From daily touch-ups to comprehensive nightly cleaning, we adapt to your operational schedule.",
    features: [
      'Day porter services',
      'Nightly contract cleaning',
      'Trash & recycling management',
      'Restroom maintenance',
      'Supply restocking',
      'Emergency spill response',
    ],
    cta: 'Get Janitorial Quote',
    image: '/img/svc-janitorial.jpg',
    imageAlt: 'Next Level Commercial Cleaning professional cleaner wiping surfaces with blue gloves in a modern office',
  },
  {
    title: 'Commercial Floor Care',
    body: "Floors are one of the first things people notice. Our floor care specialists keep your carpets, tile, hardwood, and vinyl surfaces looking their best year-round.",
    features: [
      'Carpet deep cleaning & extraction',
      'Tile & grout restoration',
      'Floor stripping & waxing',
      'Buffing & burnishing',
      'Hardwood maintenance',
      'Slip-resistant treatment',
    ],
    cta: 'Schedule Floor Care',
    image: '/img/svc-floor.jpg',
    imageAlt: 'Professional floor cleaning machine polishing commercial floor',
  },
  {
    overline: 'SPECIALIZED SERVICE',
    title: 'Medical Office Cleaning',
    body: "Healthcare facilities demand the highest sanitation standards. Our medical cleaning team is trained in HIPAA-aware protocols and CDC-compliant disinfection procedures.",
    features: [
      'Exam room sanitization',
      'Terminal cleaning',
      'Waiting area disinfection',
      'Biohazard waste handling',
      'CDC-compliant protocols',
      'HIPAA-aware staff training',
    ],
    cta: 'Request Medical Cleaning Quote',
    image: '/img/svc-medical.jpg',
    imageAlt: 'Spotlessly clean medical examination room',
  },
  {
    title: 'Post-Construction Cleaning',
    body: "Construction and renovation projects leave behind dust, debris, and residue. Our post-construction cleaning team delivers move-in ready spaces that shine.",
    features: [
      'Debris & dust removal',
      'Window & glass cleaning',
      'Surface deep cleaning',
      'Floor restoration',
      'Final polish & detailing',
      'Flexible scheduling',
    ],
    cta: 'Get Post-Construction Quote',
    image: '/img/svc-construction.jpg',
    imageAlt: 'Recently renovated commercial space after post-construction cleanup',
  },
];

const checkIcon = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4CAF50" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 flex-shrink-0"><path d="M20 6 9 17l-5-5"></path></svg>`;
---

<section id="services" class="bg-white">
  {serviceDetails.map((service, i) => (
    <div class="section-padding border-b border-[#E5E7EB] last:border-b-0">
      <div class="content-max-width">
        <div class={`flex flex-col ${i % 2 === 0 ? 'lg:flex-row' : 'lg:flex-row-reverse'} items-center gap-10 lg:gap-16`}>
          <div class="flex-1 w-full">
            <img src={service.image} alt={service.imageAlt} class="w-full rounded-2xl shadow-lg object-cover" loading="lazy" />
          </div>
          <div class="flex-1 w-full">
            {service.overline && <span class="overline">{service.overline}</span>}
            <h2 class={`text-2xl lg:text-3xl font-semibold mt-3 leading-tight text-[#0B1F3F] ${!service.overline ? 'mt-0' : ''}`}>{service.title}</h2>
            <p class="text-[#6B7280] text-lg mt-4 leading-relaxed">{service.body}</p>
            <ul class="mt-6 space-y-3">
              {service.features.map((f) => (
                <li class="flex items-start gap-3">
                  <div set:html={checkIcon}></div>
                  <span class="text-[#374151]">{f}</span>
                </li>
              ))}
            </ul>
            <div class="mt-8">
              <a href="#contact" class="btn-primary">{service.cta}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  ))}
</section>
