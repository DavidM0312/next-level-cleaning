---
const services = [
  {
    title: 'Office Cleaning',
    desc: 'Daily and weekly office cleaning, surface sanitizing, restroom maintenance, and break room cleaning for professional workspaces.',
    icon: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#0FA3A8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>`,
  },
  {
    title: 'Janitorial Services',
    desc: 'Routine janitorial programs including day porter services, nightly cleaning, trash removal, and supply restocking.',
    icon: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#0FA3A8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"></path><rect x="9" y="3" width="6" height="4" rx="2" ry="2"></rect><path d="M9 14l2 2 4-4"></path></svg>`,
  },
  {
    title: 'Floor Care',
    desc: 'Carpet deep cleaning, tile & grout restoration, floor stripping & waxing, buffing, and hardwood maintenance.',
    icon: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#0FA3A8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3Z"></path></svg>`,
  },
  {
    title: 'Medical Cleaning',
    desc: 'HIPAA-aware cleaning for medical offices, exam room sanitization, terminal cleaning, and CDC-compliant disinfection.',
    icon: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#0FA3A8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>`,
  },
  {
    title: 'Post-Construction',
    desc: 'Complete cleanup for renovated or newly built spaces — debris removal, dust elimination, window cleaning, and final polish.',
    icon: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#0FA3A8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>`,
  },
  {
    title: 'Disinfection',
    desc: 'Electrostatic spray disinfection, high-touch point sanitization, and EPA-registered antimicrobial application.',
    icon: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#0FA3A8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"></path></svg>`,
  },
];
---

<section class="section-padding bg-white">
  <div class="content-max-width">
    <div class="text-center mb-14 lg:mb-16">
      <span class="overline">WHAT WE DO</span>
      <h2 class="text-3xl lg:text-[40px] font-semibold mt-3 leading-tight text-[#0B1F3F]">Comprehensive Commercial Cleaning Solutions</h2>
      <p class="text-[#6B7280] text-lg mt-4 leading-relaxed max-w-[700px] mx-auto">From daily office maintenance to specialized disinfection services, we deliver exceptional results for every type of commercial facility.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 animate-stagger">
      {services.map((service) => (
        <div class="group bg-white border border-[#E5E7EB] rounded-xl p-8 transition-all duration-300 hover:-translate-y-1 hover:border-[#0FA3A8] hover:shadow-[0_8px_30px_rgba(0,0,0,0.08)]">
          <div class="mb-5" set:html={service.icon}></div>
          <h3 class="text-xl font-semibold mb-3 text-[#0B1F3F]">{service.title}</h3>
          <p class="text-[#6B7280] leading-relaxed mb-4">{service.desc}</p>
          <a href="#services" class="inline-flex items-center gap-1 text-sm font-medium transition-colors text-[#0FA3A8]">
            Learn More
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
