import ServicesOverview from '../sections/ServicesOverview.astro';
import WhyChooseUs from '../sections/WhyChooseUs.astro';
import IndustriesOverview from '../sections/IndustriesOverview.astro';
import ServiceDetailCards from '../sections/ServiceDetailCards.astro';
import CustomPlans from '../sections/CustomPlans.astro';
import IndustriesDetail from '../sections/IndustriesDetail.astro';
import AboutStory from '../sections/AboutStory.astro';
import MissionValues from '../sections/MissionValues.astro';
import OurPromise from '../sections/OurPromise.astro';
