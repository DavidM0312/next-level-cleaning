---
const quickLinks = [
  { label: 'Home', href: '#home' },
  { label: 'About', href: '#about' },
  { label: 'Services', href: '#services' },
  { label: 'Contact', href: '#contact' },
];

const serviceLinks = [
  'Office Cleaning',
  'Janitorial Services',
  'Floor Care',
  'Medical Cleaning',
  'Post-Construction',
  'Disinfection',
];
---

<footer class="bg-[#0B1F3F]">
  <div class="content-max-width pt-20 pb-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
      <!-- Col 1: Logo & Tagline -->
      <div>
        <a href="#home" class="inline-block mb-4 cursor-pointer">
          <span class="text-lg font-bold text-white">Next</span>
          <span class="text-lg font-bold text-[#0FA3A8]">Level</span>
          <span class="text-lg font-bold text-white"> Cleaning</span>
        </a>
        <p class="text-white/70 text-sm leading-relaxed">
          A Black-owned, family-owned commercial cleaning company serving Washington, DC with integrity and excellence.
        </p>
      </div>

      <!-- Col 2: Quick Links -->
      <div>
        <h4 class="text-white font-semibold mb-4">Quick Links</h4>
        <ul class="space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-white/70 text-sm hover:text-white transition-colors duration-200 relative group">
                {link.label}
                <span class="absolute bottom-0 left-0 w-0 h-px group-hover:w-full transition-all duration-200 bg-[#0FA3A8]"></span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Services -->
      <div>
        <h4 class="text-white font-semibold mb-4">Services</h4>
        <ul class="space-y-3">
          {serviceLinks.map((service) => (
            <li>
              <a href="#services" class="text-white/70 text-sm hover:text-white transition-colors duration-200 relative group">
                {service}
                <span class="absolute bottom-0 left-0 w-0 h-px group-hover:w-full transition-all duration-200 bg-[#0FA3A8]"></span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Contact -->
      <div>
        <h4 class="text-white font-semibold mb-4">Contact</h4>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0FA3A8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <a href="tel:2028202730" class="text-white/70 text-sm hover:text-white transition-colors">(202) 820-2730</a>
          </li>
          <li class="flex items-start gap-3">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0FA3A8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <a href="mailto:info@nxtlvlcleaning.com" class="text-white/70 text-sm hover:text-white transition-colors">info@nxtlvlcleaning.com</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-6 flex flex-col sm:flex-row justify-between items-center gap-4 border-t border-white/10">
      <p class="text-white/50 text-sm">© 2025 Next Level Commercial Cleaning. All rights reserved.</p>
      <p class="text-white/50 text-sm">Licensed, Bonded & Insured</p>
    </div>
  </div>
</footer>
